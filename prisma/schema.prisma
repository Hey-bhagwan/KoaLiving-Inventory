generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        String   @id @default(uuid())
  sku       String   @unique
  name      String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("products")
}

model InventoryLog {
  id        String   @id @default(uuid())
  sku       String
  type      String
  createdAt DateTime @default(now())

  @@map("inventory_logs")
}
